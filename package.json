{
  "name": "vector",
  "version": "0.8.0",
  "description": "Pre-generation security diagnosis of cloud infrastructure prompts using NLP. Chrome extension + CLI. Fully offline, zero dependencies.",
  "private": true,
  "scripts": {
    "test": "node engine/test/run-tests.js",
    "eval": "node engine/eval/run-eval.js",
    "eval:controls": "node engine/eval/per-control.js",
    "probe": "node engine/eval/paraphrase-probe.js",
    "verify:all": "npm test && npm run eval && npm run eval:controls && npm run probe && npm run package",
    "downstream": "node engine/eval/downstream/run-downstream.js",
    "study": "node engine/eval/downstream/run-llm-study.js",
    "kappa": "node engine/eval/kappa.js",
    "verify": "node engine/cli/vector-cli.js verify",
    "icons": "node tools/make-icons.js",
    "docx": "node tools/make-docx.js",
    "docs": "node tools/md-to-docx.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1",
    "analyze": "node engine/cli/vector-cli.js analyze",
    "improved": "node engine/cli/vector-cli.js improved",
    "webapp": "npm --prefix ui/web-app run dev",
    "webapp:build": "npm --prefix ui/web-app run build",
    "webapp:install": "npm --prefix ui/web-app install"
  },
  "license": "MIT"
}
