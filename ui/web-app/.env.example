# Copy this file to `.env.local` for local development.
# Never commit `.env.local` and never put a service-role/secret key in a VITE_
# variable: VITE_ values are shipped to the browser.

# Supabase public configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional build-time LLM defaults for local development only.
# Never ship a provider key in a production build: VITE_ values are public.
VITE_VECTOR_TEST_API_KEY=""
VITE_VECTOR_BASE_URL=""
VITE_VECTOR_MODEL=""

# Commercial builds: a serverless proxy that holds the provider key.
# The app calls <proxy>/chat/completions and the proxy forwards to the model.
# Example: https://vector-api.example.com/api
# See deploy/MODEL_PROXY.md.
VITE_VECTOR_PROXY_URL=""
